# Copy to .env and adjust. Every setting here maps to a field in app/config.py.

# --- database ---
# Dev DB from docker-compose (`make db-up`). Tests use 5433/papermind_test (`make db-test-up`).
DATABASE_URL=postgresql+psycopg://papermind:papermind@localhost:5432/papermind

# --- http ---
# Comma-separated browser origins allowed to call the API. Explicit list only —
# the frontend sends cookies and browsers reject "*" on credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Signs auth cookies. Production MUST override this with a random secret
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
SESSION_SECRET=dev-only-insecure-session-secret

# --- storage ---
STORAGE_DIR=./storage

# --- llm / embeddings ---
# LLM_PROVIDER: "gemini" (needs GEMINI_API_KEY) or "fake" for offline runs/tests.
LLM_PROVIDER=fake
LLM_MODEL=gemini-1.5-flash-latest
GEMINI_API_KEY=

# EMBEDDING_PROVIDER: "sentence-transformers" (offline default), "gemini", or "fake".
# EMBEDDING_DIM must match the model; changing it requires a migration of the vector column.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
